{
  "info": {
    "name": "Loja Café",
    "description": "Chamadas da pedidos-api (8081) e do Pagamentos (5001). Contrato em specs/api.md. Passo a passo: 1) 'POST /auth/entrar' com o ADMIN do infra/.env e copie o token da resposta para a variável 'token'; 2) crie lojas e usuários; 3) entre como atendente, copie o novo token e lance pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "pagamentosUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": "cole-o-token-aqui"
    }
  ],
  "item": [
    {
      "name": "GET /opcoes (público)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/opcoes"
      }
    },
    {
      "name": "POST /auth/entrar (ADMIN do infra/.env ou qualquer conta)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/entrar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@loja-cafe.local\",\n  \"senha\": \"a-senha-do-ADMIN_PASSWORD\"\n}"
        }
      }
    },
    {
      "name": "POST /auth/sair",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/sair"
      }
    },
    {
      "name": "GET /lojas (ADMIN)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas"
      }
    },
    {
      "name": "POST /lojas (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Centro\",\n  \"estoqueInicial\": 20\n}"
        }
      }
    },
    {
      "name": "PUT /lojas/1/estoque/2 (ADMIN ou GERENTE da loja)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas/1/estoque/2",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantidade\": 40\n}"
        }
      }
    },
    {
      "name": "GET /usuarios (ADMIN ou GERENTE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios"
      }
    },
    {
      "name": "POST /usuarios (ADMIN ou GERENTE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bia\",\n  \"email\": \"bia@loja.com\",\n  \"senha\": \"segredo123\",\n  \"papel\": \"ATENDENTE\",\n  \"lojaId\": 1\n}"
        }
      }
    },
    {
      "name": "PUT /usuarios/2/ativo (desativar)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios/2/ativo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ativo\": false\n}"
        }
      }
    },
    {
      "name": "GET /produtos (cardápio e estoque da sua loja; ADMIN usa ?lojaId=1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/produtos"
      }
    },
    {
      "name": "POST /pedidos (Pix, 2 itens; ATENDENTE ou GERENTE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Ana\",\n  \"formaPagamento\": \"PIX\",\n  \"observacao\": \"sem açúcar\",\n  \"itens\": [\n    { \"produtoId\": 2, \"quantidade\": 2, \"tamanho\": \"GRANDE\", \"extras\": [\"CHANTILLY\", \"CANELA\"] },\n    { \"produtoId\": 1, \"quantidade\": 1 }\n  ]\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (crédito acima de R$ 100: será RECUSADO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"CREDITO\",\n  \"parcelas\": 3,\n  \"itens\": [ { \"produtoId\": 4, \"quantidade\": 20, \"tamanho\": \"GRANDE\" } ]\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (inválido: espera 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"FIADO\",\n  \"itens\": [ { \"produtoId\": 99, \"quantidade\": 0, \"tamanho\": \"XG\" } ]\n}"
        }
      }
    },
    {
      "name": "GET /pedidos?limite=10 (da sua loja; ADMIN vê todas)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos?limite=10"
      }
    },
    {
      "name": "GET /cozinha (fila da loja: pedidos PAGO ainda não retirados)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/cozinha"
      }
    },
    {
      "name": "PUT /pedidos/1/preparo (COZINHA: PREPARANDO ou PRONTO; ATENDENTE: RETIRADO)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos/1/preparo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preparo\": \"PREPARANDO\"\n}"
        }
      }
    },
    {
      "name": "PUT /pedidos/1/cancelar (GERENTE)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos/1/cancelar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"cliente desistiu\"\n}"
        }
      }
    },
    {
      "name": "GET /auditoria (ADMIN ou GERENTE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auditoria?limite=50"
      }
    },
    {
      "name": "Pagamentos · GET /saude",
      "request": {
        "method": "GET",
        "url": "{{pagamentosUrl}}/saude"
      }
    },
    {
      "name": "Pagamentos · GET /pagamentos (decisões desta instância)",
      "request": {
        "method": "GET",
        "url": "{{pagamentosUrl}}/pagamentos"
      }
    }
  ]
}
