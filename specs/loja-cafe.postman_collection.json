{
  "info": {
    "name": "Loja Café",
    "description": "Chamadas da pedidos-api (8081) e do Pagamentos (5001). Contrato em specs/api.md. Rode 'POST /auth/registrar' (ou entrar), copie o token da resposta para a variável 'token' e use as chamadas de pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "pagamentosUrl", "value": "http://localhost:5001" },
    { "key": "token", "value": "cole-o-token-aqui" }
  ],
  "item": [
    {
      "name": "GET /produtos (cardápio e estoque)",
      "request": { "method": "GET", "url": "{{baseUrl}}/produtos" }
    },
    {
      "name": "GET /opcoes (tamanhos, extras e formas de pagamento)",
      "request": { "method": "GET", "url": "{{baseUrl}}/opcoes" }
    },
    {
      "name": "POST /auth/registrar",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/registrar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana\",\n  \"email\": \"ana@exemplo.com\",\n  \"senha\": \"segredo123\"\n}"
        }
      }
    },
    {
      "name": "POST /auth/entrar",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/entrar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana@exemplo.com\",\n  \"senha\": \"segredo123\"\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (Pix, 2 itens)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"PIX\",\n  \"observacao\": \"sem açúcar\",\n  \"itens\": [\n    { \"produtoId\": 2, \"quantidade\": 2, \"tamanho\": \"GRANDE\", \"extras\": [\"CHANTILLY\", \"CANELA\"] },\n    { \"produtoId\": 1, \"quantidade\": 1 }\n  ]\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (crédito acima de R$ 100: será RECUSADO)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"CREDITO\",\n  \"parcelas\": 3,\n  \"itens\": [ { \"produtoId\": 4, \"quantidade\": 20, \"tamanho\": \"GRANDE\" } ]\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (inválido: espera 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"FIADO\",\n  \"itens\": [ { \"produtoId\": 99, \"quantidade\": 0, \"tamanho\": \"XG\" } ]\n}"
        }
      }
    },
    {
      "name": "GET /pedidos?limite=10 (só os seus)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/pedidos?limite=10"
      }
    },
    {
      "name": "Pagamentos · GET /saude",
      "request": { "method": "GET", "url": "{{pagamentosUrl}}/saude" }
    },
    {
      "name": "Pagamentos · GET /pagamentos (decisões desta instância)",
      "request": { "method": "GET", "url": "{{pagamentosUrl}}/pagamentos" }
    }
  ]
}
