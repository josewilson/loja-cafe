{
  "info": {
    "name": "Loja Café",
    "description": "Chamadas da pedidos-api (8081) e do Pagamentos (5001). Contrato em specs/api.md. Passo a passo: 1) 'POST /auth/entrar' com o ADMIN do infra/.env e copie o token da resposta para a variável 'token'; 2) crie lojas e usuários; 3) entre como atendente, copie o novo token e lance pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "pagamentosUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": "cole-o-token-aqui"
    }
  ],
  "item": [
    {
      "name": "GET /opcoes (público)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/opcoes"
      }
    },
    {
      "name": "POST /auth/entrar (ADMIN do infra/.env ou qualquer conta)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/entrar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@loja-cafe.local\",\n  \"senha\": \"a-senha-do-ADMIN_PASSWORD\"\n}"
        }
      }
    },
    {
      "name": "POST /auth/sair",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/sair"
      }
    },
    {
      "name": "GET /lojas (ADMIN)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas"
      }
    },
    {
      "name": "POST /lojas (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Centro\",\n  \"estoqueInicial\": 20\n}"
        }
      }
    },
    {
      "name": "PUT /lojas/1/estoque/2 (ADMIN ou GERENTE da loja)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas/1/estoque/2",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantidade\": 40\n}"
        }
      }
    },
    {
      "name": "GET /usuarios (ADMIN ou GERENTE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios"
      }
    },
    {
      "name": "POST /usuarios (ADMIN ou GERENTE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bia\",\n  \"email\": \"bia@loja.com\",\n  \"senha\": \"segredo123\",\n  \"papel\": \"ATENDENTE\",\n  \"lojaId\": 1\n}"
        }
      }
    },
    {
      "name": "PUT /usuarios/2/ativo (desativar)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios/2/ativo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ativo\": false\n}"
        }
      }
    },
    {
      "name": "GET /produtos (cardápio e estoque da sua loja; ADMIN usa ?lojaId=1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/produtos"
      }
    },
    {
      "name": "POST /pedidos (Pix, 2 itens; ATENDENTE ou GERENTE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Ana\",\n  \"formaPagamento\": \"PIX\",\n  \"observacao\": \"sem açúcar\",\n  \"itens\": [\n    { \"produtoId\": 2, \"quantidade\": 2, \"tamanho\": \"GRANDE\", \"extras\": [\"CHANTILLY\", \"CANELA\"] },\n    { \"produtoId\": 1, \"quantidade\": 1 }\n  ]\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (crédito acima de R$ 100: será RECUSADO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"CREDITO\",\n  \"parcelas\": 3,\n  \"itens\": [ { \"produtoId\": 4, \"quantidade\": 20, \"tamanho\": \"GRANDE\" } ]\n}"
        }
      }
    },
    {
      "name": "POST /pedidos (inválido: espera 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"FIADO\",\n  \"itens\": [ { \"produtoId\": 99, \"quantidade\": 0, \"tamanho\": \"XG\" } ]\n}"
        }
      }
    },
    {
      "name": "GET /pedidos?limite=10 (da sua loja; ADMIN vê todas)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos?limite=10"
      }
    },
    {
      "name": "GET /cozinha (fila da loja: pedidos PAGO ainda não retirados)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/cozinha"
      }
    },
    {
      "name": "PUT /pedidos/1/preparo (COZINHA: PREPARANDO ou PRONTO; ATENDENTE: RETIRADO)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos/1/preparo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preparo\": \"PREPARANDO\"\n}"
        }
      }
    },
    {
      "name": "PUT /pedidos/1/cancelar (GERENTE)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos/1/cancelar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"cliente desistiu\"\n}"
        }
      }
    },
    {
      "name": "GET /relatorios/vendas?data=2026-10-17 (GERENTE; ADMIN usa lojaId=)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/relatorios/vendas"
      }
    },
    {
      "name": "GET /caixa/resumo (turno aberto)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/caixa/resumo"
      }
    },
    {
      "name": "POST /caixa/fechamentos (GERENTE fecha o turno)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/caixa/fechamentos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dinheiroContado\": 25.00,\n  \"observacao\": \"troco ok\"\n}"
        }
      }
    },
    {
      "name": "GET /caixa/fechamentos?limite=20 (histórico)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/caixa/fechamentos?limite=20"
      }
    },
    {
      "name": "GET /cardapio (ADMIN: todos os produtos, inclusive desativados)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/cardapio"
      }
    },
    {
      "name": "POST /cardapio (ADMIN cria produto; nasce com estoque 0 nas lojas)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/cardapio",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Pão na chapa\",\n  \"descricao\": \"Com manteiga\",\n  \"emoji\": \"🥖\",\n  \"preco\": 7.00\n}"
        }
      }
    },
    {
      "name": "PUT /cardapio/100 (ADMIN: preço novo e ativar/desativar)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/cardapio/100",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Pão na chapa\",\n  \"descricao\": \"Com manteiga\",\n  \"emoji\": \"🥖\",\n  \"preco\": 7.50,\n  \"ativo\": true\n}"
        }
      }
    },
    {
      "name": "GET /insumos (ADMIN/GERENTE: catálogo com estoque da loja; ADMIN usa ?lojaId=1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/insumos"
      }
    },
    {
      "name": "POST /insumos (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/insumos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Grão de café\",\n  \"unidade\": \"G\"\n}"
        }
      }
    },
    {
      "name": "PUT /insumos/1 (ADMIN: renomear, ativar/desativar)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/insumos/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Grão de café especial\",\n  \"ativo\": true\n}"
        }
      }
    },
    {
      "name": "PUT /lojas/1/insumos/1 (GERENTE da loja ou ADMIN: contagem e mínimo)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/lojas/1/insumos/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantidade\": 5000,\n  \"minimo\": 1000\n}"
        }
      }
    },
    {
      "name": "GET /insumos/alertas (o que está abaixo do mínimo)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/insumos/alertas"
      }
    },
    {
      "name": "GET /fichas/produtos/2",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/fichas/produtos/2"
      }
    },
    {
      "name": "PUT /fichas/produtos/2 (ADMIN: substitui a ficha, tamanho Médio)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/fichas/produtos/2",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itens\": [\n    { \"insumoId\": 1, \"quantidade\": 18 },\n    { \"insumoId\": 2, \"quantidade\": 150 }\n  ]\n}"
        }
      }
    },
    {
      "name": "PUT /fichas/extras/CHANTILLY (ADMIN)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/fichas/extras/CHANTILLY",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itens\": [ { \"insumoId\": 3, \"quantidade\": 20 } ]\n}"
        }
      }
    },
    {
      "name": "GET /auditoria (ADMIN ou GERENTE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auditoria?limite=50"
      }
    },
    {
      "name": "Pagamentos · GET /saude",
      "request": {
        "method": "GET",
        "url": "{{pagamentosUrl}}/saude"
      }
    },
    {
      "name": "Pagamentos · GET /pagamentos (decisões desta instância)",
      "request": {
        "method": "GET",
        "url": "{{pagamentosUrl}}/pagamentos"
      }
    }
  ]
}
