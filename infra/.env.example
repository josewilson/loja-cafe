# Modelo das credenciais. Copie para infra/.env e TROQUE as senhas (o .env de verdade não vai para o Git):
#   cp infra/.env.example infra/.env
# Quem lê este arquivo: docker compose (infra/), pedidos-api, pagamentos-py e analytics-py.
# Variáveis de ambiente com o mesmo nome têm prioridade sobre o arquivo (é assim que se configura em produção).
POSTGRES_USER=loja
POSTGRES_PASSWORD=troque-a-senha-do-postgres
KAFKA_USER=loja
KAFKA_PASSWORD=troque-a-senha-do-kafka
# Primeiro ADMIN da rede: criado pela API na primeira partida, se ainda não existir nenhum. Senha: 8 a 72 caracteres.
ADMIN_EMAIL=admin@loja-cafe.local
ADMIN_PASSWORD=troque-a-senha-do-admin

# Pix (Fase 5, opcional). automatico (padrão) = aprova na hora; simulado = QR falso que se paga com POST http://localhost:5001/pix/simular/<pedidoId>;
# mercadopago = real (veja deploy/README.md). Variáveis do Pagamentos: PIX_PROVEDOR, MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET, PUBLIC_URL.
#PIX_PROVEDOR=simulado
