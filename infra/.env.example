# Modelo das credenciais. Copie para infra/.env e TROQUE as senhas (o .env de verdade não vai para o Git):
#   cp infra/.env.example infra/.env
# Quem lê este arquivo: docker compose (infra/), pedidos-api, pagamentos-py e analytics-py.
# Variáveis de ambiente com o mesmo nome têm prioridade sobre o arquivo (é assim que se configura em produção).
POSTGRES_USER=loja
POSTGRES_PASSWORD=troque-a-senha-do-postgres
KAFKA_USER=loja
KAFKA_PASSWORD=troque-a-senha-do-kafka
