# Modelo da configuração de PRODUÇÃO. No servidor: cp deploy/.env.example deploy/.env e TROQUE todas as senhas.
# Gere senhas fortes (ex.: openssl rand -base64 24 | tr -d '/+='). Este arquivo (.env de verdade) nunca vai para o Git.
POSTGRES_USER=loja
POSTGRES_PASSWORD=troque-a-senha-do-postgres
KAFKA_USER=loja
KAFKA_PASSWORD=troque-a-senha-do-kafka
# Primeiro ADMIN da rede (criado na primeira partida, se não houver nenhum). Senha de 8 a 72 caracteres.
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=troque-a-senha-do-admin
# Endereço do sistema: um domínio (HTTPS automático), "localhost" (teste) ou ":80" (HTTP puro, só em rede local). Veja o Caddyfile.
SITE_ADDRESS=localhost

# ---- Pix (Fase 5) ----
# automatico  = pagamento SIMULADO (aprova na hora, sem cobrança). Serve para teste; em produção real, NÃO use.
# simulado    = gera um Pix de mentira, que você "paga" com POST /pix/simular/<pedidoId> no Pagamentos (teste do fluxo).
# mercadopago = Pix de verdade (precisa das 3 linhas abaixo; comece com o token de TESTE do sandbox).
PIX_PROVEDOR=automatico
#MP_ACCESS_TOKEN=
# Segredo do webhook: Mercado Pago > Suas integrações > Webhooks > chave secreta.
#MP_WEBHOOK_SECRET=
# Endereço público (https://seu-dominio) para o Mercado Pago avisar quando o Pix for pago. Sem ele, só a conferência a cada 30 s.
#PUBLIC_URL=https://cafe.exemplo.com.br
#PIX_EXPIRA_MINUTOS=10

# ---- Backup (obrigatório) ----
# Chave PÚBLICA do backup (age1...). Gere o par com deploy/gerar-chave-backup.sh e GUARDE A PRIVADA FORA DO SERVIDOR:
# sem a privada, ninguém consegue restaurar (nem você). O servidor só precisa da pública.
BACKUP_AGE_RECIPIENT=
# Hora do backup diário (fuso America/Sao_Paulo). BACKUP_AO_INICIAR=1 faz um backup logo ao subir (bom na primeira instalação).
BACKUP_HORA=03:30
BACKUP_AO_INICIAR=0
# Cópia FORA do servidor (muito recomendado: se a máquina morrer, o backup não morre junto). Exemplo para um armazenamento S3
# (Cloudflare R2, Backblaze B2...). O nome "offsite" é fixo; "bucket/loja-cafe" é o bucket e a pasta.
RCLONE_DEST=
#RCLONE_DEST=offsite:bucket/loja-cafe
#RCLONE_CONFIG_OFFSITE_TYPE=s3
#RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
#RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
#RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
#RCLONE_CONFIG_OFFSITE_ENDPOINT=https://SEU-ID.r2.cloudflarestorage.com
# Aviso se o backup PARAR de rodar: crie um "check" diário no Healthchecks.io (gratuito) e cole aqui o endereço de ping.
HEALTHCHECK_URL=
